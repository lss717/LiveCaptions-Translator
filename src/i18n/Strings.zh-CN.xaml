    <!--  欢迎窗口  -->
    <sys:String x:Key="L_Welcome_Title">开始使用</sys:String>
    <sys:String x:Key="L_Welcome_Heading">欢迎使用 LiveCaptions Translator！</sys:String>
    <sys:String x:Key="L_Welcome_Body_1">LiveCaptions Translator 基于 Windows 实时字幕。</sys:String>
    <sys:String x:Key="L_Welcome_Body_2">首次运行前，你需要按以下步骤进行配置：&#x0A;</sys:String>
    <sys:String x:Key="L_Welcome_Body_3">&#x0A;1. 打开 Windows 实时字幕，按照指引下载设备端语音识别和语言包所需的文件。</sys:String>
    <sys:String x:Key="L_Welcome_Body_4">&#x0A;2. 点击 Windows 实时字幕中的</sys:String>
    <sys:String x:Key="L_Welcome_Body_5">⚙️ 齿轮</sys:String>
    <sys:String x:Key="L_Welcome_Body_6">图标打开设置菜单，然后选择</sys:String>
    <sys:String x:Key="L_Welcome_Body_7">"位置 &gt; 覆盖在屏幕上"</sys:String>
    <sys:String x:Key="L_Welcome_Body_8">。&#x0A;3. 点击 LiveCaptions Translator 设置页中的</sys:String>
    <sys:String x:Key="L_Welcome_Body_9">"隐藏"</sys:String>
    <sys:String x:Key="L_Welcome_Body_10">按钮以隐藏 Windows 实时字幕。&#x0A;</sys:String>
    <sys:String x:Key="L_Welcome_Body_11">&#x0A;程序已自动跳转到设置页并打开 Windows 实时字幕。</sys:String>
    <sys:String x:Key="L_Welcome_Body_12">完成配置后，即可切换回主页面，享受实时音频翻译。&#x0A;</sys:String>
    <sys:String x:Key="L_Welcome_Body_13">&#x0A;更多详情，请访问我们的 wiki：</sys:String>
    <sys:String x:Key="L_Welcome_Body_14">&#x0A;&#x0A;提示：</sys:String>
    <sys:String x:Key="L_Welcome_Body_15">如需更改</sys:String>
    <sys:String x:Key="L_Welcome_Body_16">源语言</sys:String>
    <sys:String x:Key="L_Welcome_Body_17">，请在设置页 [显示] 实时字幕，并在 Windows 实时字幕中进行更改。</sys:String>
    <sys:String x:Key="L_Welcome_Button">我已充分了解并完成配置。</sys:String>

