    <sys:String x:Key="L_History_Export_FailedDetail">文件保存失败：{0}</sys:String>
    <sys:String x:Key="L_History_Export_Filter">CSV (*.csv)|*.csv|所有文件 (*.*)|*.*</sys:String>

    <!--  关于页  -->
    <sys:String x:Key="L_Info_Intro_1">我们欢迎任何形式的贡献！你可以通过 GitHub issues 提供建议或报告 bug，也可以直接提交 Pull Request 贡献代码。</sys:String>
    <sys:String x:Key="L_Info_Intro_2">&#x0A;如果这个程序对你有帮助，请考虑给我们一个 star ✨！</sys:String>
    <sys:String x:Key="L_Info_Repo">仓库：</sys:String>
    <sys:String x:Key="L_Info_Wiki">Wiki：</sys:String>
    <sys:String x:Key="L_Info_Maintainer">维护者：</sys:String>
    <sys:String x:Key="L_Info_AuthorAnd">（作者）和</sys:String>
    <sys:String x:Key="L_Info_Version">版本：</sys:String>

