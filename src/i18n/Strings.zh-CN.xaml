    <sys:String x:Key="L_Setting_Language">语言</sys:String>
    <sys:String x:Key="L_Setting_FollowSystem">跟随系统</sys:String>

    <sys:String x:Key="L_Setting_LCInfo_1">在 Windows 11 版本 24H2 之后，你只能在实时字幕中更改</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_2">源语言</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_3">。</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_4">&#x0A;&#x0A;注意：</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_5">请点击</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_6">"隐藏"</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_7">来隐藏实时字幕，而不是直接关闭它。</sys:String>

    <sys:String x:Key="L_Setting_FreqInfo_1">决定翻译 API 的调用频率。数值越小，调用越频繁。</sys:String>
    <sys:String x:Key="L_Setting_FreqInfo_2">&#x0A;字幕每变化</sys:String>
    <sys:String x:Key="L_Setting_FreqInfo_3">[API 间隔]</sys:String>
    <sys:String x:Key="L_Setting_FreqInfo_4">次后，调用一次翻译 API。</sys:String>

    <sys:String x:Key="L_Setting_ApiInfo">除 Google 和 Google2 外，其他 API 均需配置后才能使用。</sys:String>

    <sys:String x:Key="L_Setting_TLInfo_1">"没有我想要的目标语言！"</sys:String>
    <sys:String x:Key="L_Setting_TLInfo_2">&#x0A;你可以直接编辑此组合框的内容来自定义语言，建议遵循</sys:String>
    <sys:String x:Key="L_Setting_TLInfo_3">BCP 47 语言标签。</sys:String>
    <sys:String x:Key="L_Setting_TLInfo_4">&#x0A;&#x0A;注意：</sys:String>
    <sys:String x:Key="L_Setting_TLInfo_5">某些 API（如 DeepL）需要另一种方式定义目标语言，详见其官方文档。</sys:String>
    <sys:String x:Key="L_Setting_TLInfo_6">&#x0A;对于内置的目标语言无需担心，因为我们已经内置了标签映射。但如果你期望的语言不在列表中，请留意这一点。</sys:String>

    <sys:String x:Key="L_Setting_CLMInfo_1">上下文数：</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_2">启用</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_3">上下文感知</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_4">时，决定上下文句子的数量。</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_5">&#x0A;悬浮句数：</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_6">启用</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_7">日志卡片</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_8">时，决定显示的卡片数量，同时也是悬浮窗口中显示的最大句子数。</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_9">&#x0A;&#x0A;注意：</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_10">上下文数必须</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_11">大于或等于</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_12">显示句数。若不满足，程序会自动调整。</sys:String>

    <sys:String x:Key="L_Setting_CAInfo_1">结合上下文进行翻译。</sys:String>
    <sys:String x:Key="L_Setting_CAInfo_2">&#x0A;可提高翻译准确性，但会消耗更多 token。</sys:String>

