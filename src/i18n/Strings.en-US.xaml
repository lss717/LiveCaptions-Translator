    <!--  Welcome Window  -->
    <sys:String x:Key="L_Welcome_Title">Getting Started</sys:String>
    <sys:String x:Key="L_Welcome_Heading">Welcome to LiveCaptions Translator!</sys:String>
    <sys:String x:Key="L_Welcome_Body_1">LiveCaptions Translator is based on Windows LiveCaptions.</sys:String>
    <sys:String x:Key="L_Welcome_Body_2">Before your first running, you need to configure it according to the following steps:&#x0A;</sys:String>
    <sys:String x:Key="L_Welcome_Body_3">&#x0A;1. Open Windows LiveCaptions and follow the guide to download the necessary files for on-device speech recognition and language packs.</sys:String>
    <sys:String x:Key="L_Welcome_Body_4">&#x0A;2. Click the</sys:String>
    <sys:String x:Key="L_Welcome_Body_5">⚙️ gear</sys:String>
    <sys:String x:Key="L_Welcome_Body_6">icon in Windows LiveCaptions to open the settings menu, and select</sys:String>
    <sys:String x:Key="L_Welcome_Body_7">"Position &gt; Overlaid on screen"</sys:String>
    <sys:String x:Key="L_Welcome_Body_8">.&#x0A;3. Click the</sys:String>
    <sys:String x:Key="L_Welcome_Body_9">"Hide"</sys:String>
    <sys:String x:Key="L_Welcome_Body_10">button located in the setting page of LiveCaptions Translator to hide Windows LiveCaptions.&#x0A;</sys:String>
    <sys:String x:Key="L_Welcome_Body_11">&#x0A;The program has automatically navigated to the setting page and opened Windows LiveCaptions.</sys:String>
    <sys:String x:Key="L_Welcome_Body_12">After completing the configuration, you can switch back to the main page and enjoy real-time audio translation.&#x0A;</sys:String>
    <sys:String x:Key="L_Welcome_Body_13">&#x0A;For more details, visit our wiki: </sys:String>
    <sys:String x:Key="L_Welcome_Body_14">&#x0A;&#x0A;Tip:</sys:String>
    <sys:String x:Key="L_Welcome_Body_15">To change the</sys:String>
    <sys:String x:Key="L_Welcome_Body_16">Source Language</sys:String>
    <sys:String x:Key="L_Welcome_Body_17">, please [Show] LiveCaptions on the setting page and do it in Windows LiveCaptions.</sys:String>
    <sys:String x:Key="L_Welcome_Button">I have fully understood and configured.</sys:String>

