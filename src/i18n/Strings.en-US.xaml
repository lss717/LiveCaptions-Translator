    <!--  Setting Page  -->
    <sys:String x:Key="L_Setting_LiveCaptions">LiveCaptions</sys:String>
    <sys:String x:Key="L_Setting_ApiInterval">API Interval</sys:String>
    <sys:String x:Key="L_Setting_TranslateApi">Translate API</sys:String>
    <sys:String x:Key="L_Setting_TargetLanguage">Target Language</sys:String>
    <sys:String x:Key="L_Setting_ApiSetting">API Setting</sys:String>
    <sys:String x:Key="L_Setting_Open">Open</sys:String>
    <sys:String x:Key="L_Setting_ShowLatency">Show Latency</sys:String>
    <sys:String x:Key="L_Setting_Contexts">Contexts</sys:String>
    <sys:String x:Key="L_Setting_DisplaySentences">Display Sentences</sys:String>
