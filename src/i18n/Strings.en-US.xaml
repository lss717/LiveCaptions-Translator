    <sys:String x:Key="L_Api_Ollama_Info_1">No need to explicitly add</sys:String>
    <sys:String x:Key="L_Api_Ollama_Info_2">`api/chat`</sys:String>
    <sys:String x:Key="L_Api_Ollama_Info_3">suffix.</sys:String>
    <sys:String x:Key="L_Api_LMStudio_Info_1">Base URL ending with</sys:String>
    <sys:String x:Key="L_Api_LMStudio_Info_2">`api/v1`</sys:String>
    <sys:String x:Key="L_Api_LMStudio_Info_3">. Chat endpoint and models are appended automatically.</sys:String>
