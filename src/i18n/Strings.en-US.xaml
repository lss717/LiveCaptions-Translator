    <sys:String x:Key="L_Setting_Language">Language</sys:String>
    <sys:String x:Key="L_Setting_FollowSystem">Follow System</sys:String>

    <sys:String x:Key="L_Setting_LCInfo_1">After Windows 11 version 24H2, you can only change the</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_2">Source Language</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_3">in LiveCaptions.</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_4">&#x0A;&#x0A;Note:</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_5">Please click</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_6">"Hide"</sys:String>
    <sys:String x:Key="L_Setting_LCInfo_7">to hide LiveCaptions instead of closing it directly.</sys:String>

    <sys:String x:Key="L_Setting_FreqInfo_1">Determines the frequency of translate API calls. The smaller it is, the more frequent API calls.</sys:String>
    <sys:String x:Key="L_Setting_FreqInfo_2">&#x0A;The translate API is called once after the caption changes</sys:String>
    <sys:String x:Key="L_Setting_FreqInfo_3">[API Interval]</sys:String>
    <sys:String x:Key="L_Setting_FreqInfo_4">times.</sys:String>

    <sys:String x:Key="L_Setting_ApiInfo">Except for Google and Google2, all other APIs require configuring before they can be used.</sys:String>

    <sys:String x:Key="L_Setting_TLInfo_1">"There isn't the target language I expect!"</sys:String>
    <sys:String x:Key="L_Setting_TLInfo_2">&#x0A;You can directly edit the content of this combobox to customize the language, and it is recommended to follow the</sys:String>
    <sys:String x:Key="L_Setting_TLInfo_3">BCP 47 language tag.</sys:String>
    <sys:String x:Key="L_Setting_TLInfo_4">&#x0A;&#x0A;Note:</sys:String>
    <sys:String x:Key="L_Setting_TLInfo_5">Some of APIs (such as DeepL) needs another way to define target language, see their official docs for more details.</sys:String>
    <sys:String x:Key="L_Setting_TLInfo_6">&#x0A;No need to consider this for included target languages, since we've built in tag mappings. But if your expected language isn't in the list, keep this in mind.</sys:String>

    <sys:String x:Key="L_Setting_CLMInfo_1">Contexts:</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_2">Determines the number of context sentences when</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_3">Context Aware</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_4">is enabled.</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_5">&#x0A;Overlay Sentences:</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_6">Determines the number of displayed cards when</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_7">Log Cards</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_8">is enabled, as well as the max number of sentences displayed in the Overlay Window.</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_9">&#x0A;&#x0A;Note:</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_10">Contexts must be</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_11">greater than or equal</sys:String>
    <sys:String x:Key="L_Setting_CLMInfo_12">Display Sentences. If not met, the program will automatically adjust them.</sys:String>

    <sys:String x:Key="L_Setting_CAInfo_1">Translate in context.</sys:String>
    <sys:String x:Key="L_Setting_CAInfo_2">&#x0A;It can improve translation accuracy, but will consume more tokens.</sys:String>

